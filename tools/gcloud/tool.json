{
  "source": {
    "datasource": "docker",
    "packageName": "google/cloud-sdk",
    "versioning": "semver",
    "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
  },
  "publish": {
    "lines": {
      "*": {
        "from": "594.0.0",
        "reason": "one line: gcloud's major changes every week"
      }
    }
  },
  "setup": {
    "action": "google-github-actions/setup-gcloud",
    "versionInput": "version"
  }
}
